<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Brand List View -->
    <record id="asset_brand_view_tree" model="ir.ui.view">
        <field name="name">asset.brand.tree</field>
        <field name="model">asset.brand</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="category"/>
            </list>
        </field>
    </record>

    <!-- Brand Form View -->
    <record id="asset_brand_view_form" model="ir.ui.view">
        <field name="name">asset.brand.form</field>
        <field name="model">asset.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Models">
                            <field name="model_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Brand Action -->
    <record id="asset_brand_action" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">asset.brand</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
