<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Asset Request - List View                                     -->
    <!-- ============================================================ -->
    <record id="asset_request_view_tree" model="ir.ui.view">
        <field name="name">asset.request.tree</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state == 'waiting_approval'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="description" optional="hide"/>
                <field name="date" options="{'numeric': True}"/>
                <field name="partner_id"/>
                <field name="request_type"/>
                <field name="required_date" options="{'numeric': True}"/>
                <field name="max_approval_level" string="Req. Level" optional="hide"/>
                <field name="current_approval_level" string="Current Level" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'waiting_approval'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Asset Request - Form View                                     -->
    <!-- ============================================================ -->
    <record id="asset_request_view_form" model="ir.ui.view">
        <field name="name">asset.request.form</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight"
                            invisible="state != 'waiting_approval' or not is_current_approver"
                            groups="asset_request.group_approver_l1"/>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-danger"
                            invisible="state != 'waiting_approval' or not is_current_approver"
                            groups="asset_request.group_approver_l1"/>
                    <field name="is_current_approver" invisible="1"/>
                    <field name="can_reset_to_draft" invisible="1"/>
                    <button name="action_reset_to_draft" type="object" string="Create Revision"
                            invisible="not can_reset_to_draft"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,waiting_approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Auto-generated"/>
                        </h1>
                        <label for="description"/>
                        <field name="description" placeholder="Description / purpose of this request..."
                               readonly="state != 'draft'"/>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"
                                   options="{'numeric': True}"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="request_type" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="required_date" readonly="state != 'draft'"
                                   options="{'numeric': True}"/>
                            <field name="flow_id" readonly="state != 'draft'"/>
                            <field name="max_approval_level" string="Required Approval Level"/>
                            <field name="current_approval_level" string="Current Pending Level"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" readonly="state != 'draft'"
                               placeholder="Additional notes..."/>
                    </group>
                    <group>
                        <field name="attachment" filename="attachment_filename"
                               readonly="state != 'draft'"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Request Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" string="No" readonly="1"/>
                                    <field name="brand_id"/>
                                    <field name="model_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval History">
                            <field name="approval_history_ids" readonly="1">
                                <list decoration-success="status == 'approved'"
                                      decoration-danger="status == 'rejected'"
                                      decoration-warning="status == 'pending'"
                                      decoration-muted="status == 'no_action'"
                                      decoration-info="cycle % 2 == 0">
                                    <field name="cycle" widget="badge"
                                           decoration-success="cycle % 2 != 0"
                                           decoration-info="cycle % 2 == 0"/>
                                    <field name="level_sequence" string="Level"/>
                                    <field name="role"/>
                                    <field name="approver_id" string="Approver"/>
                                    <field name="is_delegation" widget="boolean"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'approved'"
                                           decoration-danger="status == 'rejected'"
                                           decoration-warning="status == 'pending'"
                                           decoration-muted="status == 'no_action'"/>
                                    <field name="date" options="{'numeric': True}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Asset Request - Search View                                   -->
    <!-- ============================================================ -->
    <record id="asset_request_view_search" model="ir.ui.view">
        <field name="name">asset.request.search</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="request_type"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Waiting Approval" name="filter_waiting" domain="[('state', '=', 'waiting_approval')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Request Type" name="group_type" context="{'group_by': 'request_type'}"/>
                    <filter string="Requestor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Required Date" name="group_req_date" context="{'group_by': 'required_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Asset Request - Action                                        -->
    <!-- ============================================================ -->
    <record id="asset_request_action" model="ir.actions.act_window">
        <field name="name">Asset Requests</field>
        <field name="res_model">asset.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_waiting': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first asset request!
            </p>
        </field>
    </record>
</odoo>
