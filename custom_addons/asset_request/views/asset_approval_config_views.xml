<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Approval Configuration - List View                            -->
    <!-- ============================================================ -->
    <record id="asset_approval_config_view_tree" model="ir.ui.view">
        <field name="name">asset.approval.config.tree</field>
        <field name="model">asset.approval.config</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="level"/>
                <field name="role"/>
                <field name="approver_id"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Approval Configuration - Form View                            -->
    <!-- ============================================================ -->
    <record id="asset_approval_config_view_form" model="ir.ui.view">
        <field name="name">asset.approval.config.form</field>
        <field name="model">asset.approval.config</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="level"/>
                            <field name="role"/>
                        </group>
                    </group>
                    <group string="Approver">
                        <field name="approver_id" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Approval Configuration - Action                               -->
    <!-- ============================================================ -->
    <record id="asset_approval_config_action" model="ir.actions.act_window">
        <field name="name">Approval Configuration</field>
        <field name="res_model">asset.approval.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure approvers for each approval level.
            </p>
            <p>
                Define which users are allowed to approve asset requests
                at each level (Manager, Sr. Manager, Director).
            </p>
        </field>
    </record>
</odoo>
