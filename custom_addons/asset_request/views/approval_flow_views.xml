<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Approval Flow - List View                                     -->
    <!-- ============================================================ -->
    <record id="approval_flow_view_tree" model="ir.ui.view">
        <field name="name">approval.flow.tree</field>
        <field name="model">approval.flow</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Approval Flow - Form View                                     -->
    <!-- ============================================================ -->
    <record id="approval_flow_view_form" model="ir.ui.view">
        <field name="name">approval.flow.form</field>
        <field name="model">approval.flow</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Asset Request Approval"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="description" placeholder="Description of this approval flow..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval Levels">
                            <field name="level_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="role"/>
                                    <field name="group_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Approval Flow - Action                                        -->
    <!-- ============================================================ -->
    <record id="approval_flow_action" model="ir.actions.act_window">
        <field name="name">Approval Flows</field>
        <field name="res_model">approval.flow</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first approval flow!
            </p>
            <p>
                Define approval workflows with multiple levels, rules, and approvers.
            </p>
        </field>
    </record>
</odoo>
