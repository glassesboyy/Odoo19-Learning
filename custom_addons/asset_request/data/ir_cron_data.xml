<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_cron_approval_reminder" model="ir.cron">
        <field name="name">Asset Request: Daily Approval Reminder</field>
        <field name="model_id" ref="model_asset_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_approval_reminder()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
