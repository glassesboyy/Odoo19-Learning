<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit res.users form view to add Properties tab -->
    <record id="res_users_view_form_inherit_estate" model="ir.ui.view">
        <field name="name">res.users.form.inherit.estate</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Properties" name="estate_properties">
                    <field name="property_ids">
                        <list>
                            <field name="name" string="Title"/>
                            <field name="expected_price"/>
                            <field name="state"/>
                            <field name="date_availability" string="Available From"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
