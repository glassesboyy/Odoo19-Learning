<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Property Types -->
    <record id="property_type_house" model="estate.property.type">
        <field name="name">House</field>
    </record>

    <record id="property_type_apartment" model="estate.property.type">
        <field name="name">Apartment</field>
    </record>

    <record id="property_type_villa" model="estate.property.type">
        <field name="name">Villa</field>
    </record>

    <record id="property_type_condo" model="estate.property.type">
        <field name="name">Condo</field>
    </record>

    <!-- Property Tags -->
    <record id="property_tag_cozy" model="estate.property.tag">
        <field name="name">Cozy</field>
    </record>

    <record id="property_tag_renovated" model="estate.property.tag">
        <field name="name">Renovated</field>
    </record>

    <record id="property_tag_luxury" model="estate.property.tag">
        <field name="name">Luxury</field>
    </record>

    <record id="property_tag_city_center" model="estate.property.tag">
        <field name="name">In City Center</field>
    </record>

    <record id="property_tag_ocean_view" model="estate.property.tag">
        <field name="name">Ocean View</field>
    </record>

    <record id="property_tag_pool" model="estate.property.tag">
        <field name="name">With Pool</field>
    </record>

    <record id="property_tag_modern" model="estate.property.tag">
        <field name="name">Modern</field>
    </record>

    <!-- ========================================= -->
    <!-- DEMO PROPERTIES (5 Properties) -->
    <!-- ========================================= -->

    <!-- Property 1: New - No offers yet -->
    <record id="estate_property_demo_1" model="estate.property">
        <field name="name">Luxury Villa with Ocean View</field>
        <field name="description">Beautiful 5-bedroom villa with stunning ocean views, private pool, and garden</field>
        <field name="postcode">10001</field>
        <field name="date_availability">2026-03-15</field>
        <field name="expected_price">500000</field>
        <field name="bedrooms">5</field>
        <field name="living_area">350</field>
        <field name="facades">3</field>
        <field name="garage">True</field>
        <field name="garden">True</field>
        <field name="garden_area">200</field>
        <field name="garden_orientation">south</field>
        <field name="active">True</field>
        <field name="state">new</field>
        <field name="property_type_id" ref="property_type_villa"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <field name="tag_ids" eval="[(6, 0, [ref('property_tag_luxury'), ref('property_tag_ocean_view'), ref('property_tag_pool')])]"/>
    </record>

    <!-- Property 2: Offer Received - Has multiple offers -->
    <record id="estate_property_demo_2" model="estate.property">
        <field name="name">Modern City Apartment</field>
        <field name="description">Cozy 2-bedroom apartment in the heart of downtown</field>
        <field name="postcode">20045</field>
        <field name="date_availability">2026-04-01</field>
        <field name="expected_price">180000</field>
        <field name="bedrooms">2</field>
        <field name="living_area">85</field>
        <field name="facades">1</field>
        <field name="garage">False</field>
        <field name="garden">False</field>
        <field name="garden_area">0</field>
        <field name="active">True</field>
        <field name="state">offer_received</field>
        <field name="property_type_id" ref="property_type_apartment"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <field name="tag_ids" eval="[(6, 0, [ref('property_tag_cozy'), ref('property_tag_modern'), ref('property_tag_city_center')])]"/>
    </record>

    <!-- Property 3: Offer Accepted - Has buyer and selling price -->
    <record id="estate_property_demo_3" model="estate.property">
        <field name="name">Spacious Family House</field>
        <field name="description">Perfect family home with 4 bedrooms, large backyard, and quiet neighborhood</field>
        <field name="postcode">30112</field>
        <field name="date_availability">2026-05-10</field>
        <field name="expected_price">320000</field>
        <field name="selling_price">325000</field>
        <field name="bedrooms">4</field>
        <field name="living_area">180</field>
        <field name="facades">2</field>
        <field name="garage">True</field>
        <field name="garden">True</field>
        <field name="garden_area">150</field>
        <field name="garden_orientation">east</field>
        <field name="active">True</field>
        <field name="state">offer_accepted</field>
        <field name="property_type_id" ref="property_type_house"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <field name="buyer_id" ref="base.res_partner_2"/>
        <field name="tag_ids" eval="[(6, 0, [ref('property_tag_cozy')])]"/>
    </record>

    <!-- Property 4: Sold - Has buyer and selling price -->
    <record id="estate_property_demo_4" model="estate.property">
        <field name="name">Beachfront Condo</field>
        <field name="description">Beautiful 3-bedroom condo right on the beach with amazing sunset views</field>
        <field name="postcode">60554</field>
        <field name="date_availability">2026-04-15</field>
        <field name="expected_price">275000</field>
        <field name="selling_price">280000</field>
        <field name="bedrooms">3</field>
        <field name="living_area">120</field>
        <field name="facades">2</field>
        <field name="garage">True</field>
        <field name="garden">False</field>
        <field name="garden_area">0</field>
        <field name="active">True</field>
        <field name="state">sold</field>
        <field name="property_type_id" ref="property_type_condo"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <field name="buyer_id" ref="base.res_partner_3"/>
        <field name="tag_ids" eval="[(6, 0, [ref('property_tag_ocean_view'), ref('property_tag_modern')])]"/>
    </record>

    <!-- Property 5: New - No offers -->
    <record id="estate_property_demo_5" model="estate.property">
        <field name="name">Renovated Downtown Loft</field>
        <field name="description">Trendy 1-bedroom loft in artistic district with high ceilings and exposed brick</field>
        <field name="postcode">40220</field>
        <field name="date_availability">2026-03-20</field>
        <field name="expected_price">150000</field>
        <field name="bedrooms">1</field>
        <field name="living_area">65</field>
        <field name="facades">1</field>
        <field name="garage">False</field>
        <field name="garden">False</field>
        <field name="garden_area">0</field>
        <field name="active">True</field>
        <field name="state">new</field>
        <field name="property_type_id" ref="property_type_apartment"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <field name="tag_ids" eval="[(6, 0, [ref('property_tag_renovated'), ref('property_tag_city_center'), ref('property_tag_modern')])]"/>
    </record>

    <!-- ========================================= -->
    <!-- PROPERTY OFFERS -->
    <!-- ========================================= -->

    <!-- Offers for Property 2 (Modern City Apartment - Offer Received) -->
    <record id="property_offer_1" model="estate.property.offer">
        <field name="price">175000</field>
        <field name="partner_id" ref="base.res_partner_4"/>
        <field name="property_id" ref="estate_property_demo_2"/>
    </record>

    <record id="property_offer_2" model="estate.property.offer">
        <field name="price">178000</field>
        <field name="partner_id" ref="base.res_partner_10"/>
        <field name="property_id" ref="estate_property_demo_2"/>
    </record>

    <!-- Offer for Property 3 (Spacious Family House - Offer Accepted) -->
    <record id="property_offer_3" model="estate.property.offer">
        <field name="price">325000</field>
        <field name="partner_id" ref="base.res_partner_2"/>
        <field name="property_id" ref="estate_property_demo_3"/>
        <field name="status">accepted</field>
    </record>

    <!-- Offers for Property 4 (Beachfront Condo - Sold) -->
    <record id="property_offer_4" model="estate.property.offer">
        <field name="price">270000</field>
        <field name="partner_id" ref="base.res_partner_12"/>
        <field name="property_id" ref="estate_property_demo_4"/>
        <field name="status">refused</field>
    </record>

    <record id="property_offer_5" model="estate.property.offer">
        <field name="price">280000</field>
        <field name="partner_id" ref="base.res_partner_3"/>
        <field name="property_id" ref="estate_property_demo_4"/>
        <field name="status">accepted</field>
    </record>

</odoo>
